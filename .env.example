# Supabase 대시보드의 Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase 대시보드의 Publishable key (sb_publishable_...)
# 구형 프로젝트라면 Legacy anon key도 사용할 수 있습니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# 서버에서만 쓰는 Secret key (sb_secret_...). 절대 NEXT_PUBLIC_을 붙이지 마세요.
# 구형 프로젝트라면 Legacy service_role key도 사용할 수 있습니다.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# /admin에서 입력할 비밀번호
ADMIN_PASSWORD=change-this-admin-password

# 관리자 세션 서명용 임의 문자열 (32자 이상 권장)
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
